# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored and is the only env file Next.js loads.

# --- MongoDB (optional: falls back to the JSON file store when unset) --------
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="tejora"

# --- Auth.js ----------------------------------------------------------------
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Seeded admin account (created on first login / by `npm run seed`)
ADMIN_EMAIL="admin@tejora.com"
ADMIN_PASSWORD="change-this-password"

# --- Cloudinary (product image uploads) -------------------------------------
# Option A — three values from Cloudinary → Dashboard → API Keys:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Option B — the single "API environment variable" string Cloudinary gives you:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
